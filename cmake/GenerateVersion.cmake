# Writes the version header at build time (run with cmake -P on every build), so
# the git commit is current without reconfiguring. The file is only rewritten when
# its content changes, so an unchanged commit recompiles nothing.
#
# Inputs: SOURCE_DIR, OUTPUT, VERSION (from project()), LABEL ("dev", "beta.1", or
# empty for a final release).

set(commit "")
set(dirty 0)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=7 HEAD
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
                    RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        set(commit "")
    endif()
    # Uncommitted changes to tracked files make a build "dirty": it is not exactly
    # the commit it names.
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT changes STREQUAL "")
        set(dirty 1)
    endif()
endif()

set(content "// Generated by cmake/GenerateVersion.cmake on every build. Do not edit.
#pragma once
#define NORTHLIGHT_VERSION_NUMBER \"${VERSION}\"
#define NORTHLIGHT_VERSION_LABEL \"${LABEL}\"
#define NORTHLIGHT_GIT_COMMIT \"${commit}\"
#define NORTHLIGHT_GIT_DIRTY ${dirty}
")

set(existing "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
