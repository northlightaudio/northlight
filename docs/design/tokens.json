{
  "$comment": "Aural design tokens. Loaded by ui::Theme. Colours are sRGB hex with optional alpha (#RRGGBBAA). Sizes are device-independent px at 100% scale. See docs/design/02-design-system.md.",
  "meta": { "name": "Aural Dark", "version": 1, "scheme": "dark" },

  "color": {
    "canvas":            "#0F0F10",
    "surface0":          "#161618",
    "surface1":          "#1D1D20",
    "surface2":          "#26262A",
    "surface3":          "#2F2F34",
    "surfacePressed":    "#1A1A1D",
    "overlay":           "#0F0F10B3",

    "lineSubtle":        "#FFFFFF0F",
    "lineStrong":        "#FFFFFF1F",
    "lineFocus":         "#7AA2FFB3",

    "textPrimary":       "#ECECEE",
    "textSecondary":     "#A0A0A8",
    "textTertiary":      "#6E6E78",
    "textDisabled":      "#4A4A52",
    "textOnAccent":      "#0B1020",
    "textOnColour":      "#0F0F10",

    "accent":            "#7AA2FF",
    "accentHover":       "#93B4FF",
    "accentPressed":     "#6690F0",
    "accentSubtle":      "#7AA2FF1F",
    "selectionFill":     "#7AA2FF24",
    "selectionOutline":  "#7AA2FF",

    "record":            "#FF4D5A",
    "recordHover":       "#FF6670",
    "recordSubtle":      "#FF4D5A1F",
    "danger":            "#FF5C5C",
    "warning":           "#F5B942",
    "success":           "#4CD08A",
    "info":              "#7AA2FF",

    "mute":              "#9AA5B8",
    "solo":              "#F2C14E",
    "arm":               "#FF4D5A",
    "monitor":           "#4FD1A1",

    "meterLow":          "#43C97E",
    "meterMid":          "#E8C84A",
    "meterHot":          "#FF8A3D",
    "meterClip":         "#FF3B3B",
    "meterTrack":        "#FFFFFF0A",
    "meterPeakHold":     "#ECECEE",
    "loudnessTarget":    "#7AA2FF",

    "playhead":          "#FFFFFFE6",
    "playheadRecording": "#FF4D5A",
    "gridBar":           "#FFFFFF14",
    "gridBeat":          "#FFFFFF0A",
    "gridSub":           "#FFFFFF05",
    "rulerText":         "#A0A0A8",
    "loopFill":          "#7AA2FF14",
    "loopEdge":          "#7AA2FF99",
    "punchFill":         "#FF4D5A14",
    "punchEdge":         "#FF4D5A99",
    "markerFlag":        "#A0A0A8",
    "regionFill":        "#FFFFFF0A",
    "laneAlt":           "#FFFFFF03",
    "laneHover":         "#FFFFFF06",
    "laneSelected":      "#7AA2FF0F",
    "dropTarget":        "#7AA2FF33",
    "snapGuide":         "#7AA2FF",

    "automation":        "#FF9548",
    "midiNote":          "#7AA2FF",
    "midiNoteVelocityLow": "#7AA2FF80"
  },

  "track": {
    "palette": [
      { "name": "Coral",     "value": "#FF6B6B" },
      { "name": "Tangerine", "value": "#FF9548" },
      { "name": "Amber",     "value": "#F2C14E" },
      { "name": "Lime",      "value": "#B5D45A" },
      { "name": "Mint",      "value": "#4FD1A1" },
      { "name": "Teal",      "value": "#38C5D4" },
      { "name": "Sky",       "value": "#5BB3FF" },
      { "name": "Indigo",    "value": "#7F8CFF" },
      { "name": "Violet",    "value": "#A78BFA" },
      { "name": "Magenta",   "value": "#E87BD6" },
      { "name": "Rose",      "value": "#FF7EA8" },
      { "name": "Slate",     "value": "#9AA5B8" }
    ],
    "defaultBus": "Slate",
    "clipBodyAlpha": 0.22,
    "clipBodySelectedAlpha": 0.32,
    "clipHeaderAlpha": 0.55,
    "waveformAlpha": 0.9,
    "waveformMutedAlpha": 0.35,
    "headerStripeWidth": 4
  },

  "font": {
    "ui":   { "family": "Inter", "file": "Inter-Variable.ttf" },
    "mono": { "family": "JetBrains Mono", "file": "JetBrainsMono-Variable.ttf" },
    "size": {
      "caption": 11,
      "small":   12,
      "body":    13,
      "label":   13,
      "title":   16,
      "heading": 20,
      "timeLarge": 22,
      "timeSmall": 13,
      "value":   12
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "lineHeight": 1.3,
    "letterSpacingCaps": 0.04
  },

  "space": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },

  "radius": { "sm": 3, "md": 6, "lg": 10, "pill": 999 },

  "size": {
    "controlCompact": 24,
    "control": 28,
    "controlLarge": 32,
    "iconSmall": 14,
    "icon": 16,
    "iconLarge": 20,
    "headerBar": 48,
    "statusBar": 24,
    "ruler": 32,
    "trackHeaderWidth": 220,
    "trackHeaderMinWidth": 160,
    "trackHeaderMaxWidth": 360,
    "trackRowMin": 28,
    "trackRow": 56,
    "trackRowLarge": 112,
    "trackRowMax": 240,
    "clipHeader": 18,
    "mixerStripWidth": 84,
    "mixerStripWideWidth": 112,
    "faderTravel": 200,
    "faderCap": [36, 14],
    "knob": 28,
    "meterWidth": 6,
    "meterGap": 2,
    "scrollbar": 10,
    "splitter": 5,
    "panelMin": 240,
    "dockMin": 200,
    "focusRing": 2,
    "tooltipMaxWidth": 320
  },

  "motion": {
    "hoverMs": 100,
    "pressMs": 60,
    "toggleMs": 120,
    "panelMs": 180,
    "menuMs": 120,
    "toastMs": 200,
    "tooltipDelayMs": 500,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "meterRiseMs": 0,
    "meterFallDbPerSec": 20,
    "peakHoldMs": 1500,
    "reduceMotion": "honour-os-setting"
  },

  "meter": {
    "floorDb": -60,
    "zones": [
      { "fromDb": -60, "toDb": -18, "color": "meterLow" },
      { "fromDb": -18, "toDb": -6,  "color": "meterMid" },
      { "fromDb": -6,  "toDb": 0,   "color": "meterHot" }
    ],
    "clipHoldMs": 3000,
    "scaleTicksDb": [0, -6, -12, -18, -24, -36, -48, -60],
    "loudnessTargetLufs": -14,
    "loudnessRangeLufs": [-36, 0]
  },

  "elevation": {
    "popup": { "shadow": "0 8 24 #00000080", "border": "lineStrong" },
    "window": { "shadow": "none", "border": "lineSubtle" }
  },

  "material": {
    "$comment": "Tactile layer (design language B): panels stay flat; only controls get depth. Applied by AuralLookAndFeel to buttons, toggles, keys, fader caps, knobs, meters and readouts, never to surfaces.",
    "controlTop":        "#2C2C31",
    "controlBottom":     "#222226",
    "controlHighlight":  "#FFFFFF14",
    "controlShadow":     "0 1 1 #00000080",
    "pressedInset":      "inset 0 1 2 #000000CC",
    "capTop":            "#3A3A40",
    "capBottom":         "#26262A",
    "capHighlight":      "#FFFFFF26",
    "capShadow":         "0 2 3 #000000A6",
    "groove":            "#121214",
    "grooveInset":       "inset 0 1 2 #000000CC",
    "grooveLip":         "#FFFFFF0F",
    "knobBodyLight":     "#3E3E46",
    "knobBodyDark":      "#1C1C20",
    "knobRim":           "#111113",
    "knobHighlight":     "#FFFFFF26",
    "meterWell":         "#0B0B0C",
    "meterWellInset":    "inset 0 1 2 #000000CC",
    "ledPitchPx":        2,
    "ledGapPx":          1,
    "glowAccent":        "0 0 10 #7AA2FF66",
    "glowRecord":        "0 0 12 #FF4D5A80",
    "glowSolo":          "0 0 10 #F2C14E66",
    "glowMonitor":       "0 0 10 #4FD1A166",
    "readoutWell":       "#121214",
    "readoutText":       "#E8C84A",
    "readoutRecord":     "#FF4D5A"
  }
}
