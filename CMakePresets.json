{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows x64 RelWithDebInfo",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "NORTHLIGHT_RT_CHECKS": "OFF" }
    },
    {
      "name": "package",
      "displayName": "Package (Release, warnings as errors; scripts/package.ps1)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NORTHLIGHT_RT_CHECKS": "OFF",
        "NORTHLIGHT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (RelWithDebInfo, warnings as errors)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NORTHLIGHT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64 Debug",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-relwithdebinfo",
      "displayName": "Linux x64 RelWithDebInfo",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux-package",
      "displayName": "Linux package (Release, static C++ runtime; scripts/package-linux.sh)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NORTHLIGHT_RT_CHECKS": "OFF",
        "NORTHLIGHT_STATIC_RUNTIME": "ON"
      }
    },
    {
      "name": "linux-ci",
      "displayName": "Linux CI (RelWithDebInfo, warnings as errors)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NORTHLIGHT_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-relwithdebinfo", "configurePreset": "windows-relwithdebinfo" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "package", "configurePreset": "package" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-relwithdebinfo", "configurePreset": "linux-relwithdebinfo" },
    { "name": "linux-ci", "configurePreset": "linux-ci" },
    { "name": "linux-package", "configurePreset": "linux-package" }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } },
    { "name": "windows-relwithdebinfo", "configurePreset": "windows-relwithdebinfo", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } },
    { "name": "package", "configurePreset": "package", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } },
    { "name": "ci", "configurePreset": "ci", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } },
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } },
    { "name": "linux-relwithdebinfo", "configurePreset": "linux-relwithdebinfo", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } },
    { "name": "linux-ci", "configurePreset": "linux-ci", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } },
    { "name": "linux-package", "configurePreset": "linux-package", "output": { "outputOnFailure": true }, "execution": { "timeout": 300, "jobs": 8 } }
  ]
}
